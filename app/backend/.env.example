# Scaffold-only environment contract. Copy to .env for local development.
# Never commit a real .env file.

# SQLAlchemy database URL (SQLite file, per DEC-005).
DATABASE_URL=sqlite:///./app.db

# CORS origin for the local Vite frontend dev server.
FRONTEND_ORIGIN=http://localhost:5173

# --- ACRI-66 authentication ---

# Demo-account seeding (ACRI-66). These are obviously-fake POC placeholders,
# not real credentials — replace in your own untracked `.env` if you want
# different local demo values. Never put a real/production-shaped password
# here; this file is committed to version control.
SEED_KITCHEN_MANAGER_EMAIL=kitchen.manager@example.com
SEED_KITCHEN_MANAGER_PASSWORD=changeme-not-a-real-secret
SEED_FB_MANAGER_EMAIL=fb.manager@example.com
SEED_FB_MANAGER_PASSWORD=changeme-also-not-a-real-secret

# Session cookie `Secure` flag. Must be `true` once the AWS/TLS hosting
# topology (ARCH-018, still open) is decided; `false` is correct for local
# (non-HTTPS) dev only.
SESSION_COOKIE_SECURE=false

# Failed-login alerting (WARN-level log only, no lockout — see plan A5).
FAILED_LOGIN_ALERT_THRESHOLD=5
FAILED_LOGIN_ALERT_WINDOW_MINUTES=15
